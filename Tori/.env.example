DISCORD_TOKEN= REPLACE_WITH_DISCORD_TOKEN
# Optional: Server-ID fuer sofort verfuegbare Slash-Commands (sonst global)
DISCORD_GUILD_ID=
LAVALINK_PASSWORD=bitte_ein_langes_zufaelliges_passwort_eintragen
# Spotify Developer App: fuer Spotify-Suche erforderlich
SPOTIFY_CLIENT_ID=REPLACE_WITH_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET= REPLACE_WITH_SPOTIFY_CLIENT_SECRET
# Optional: Webhook aus dem Modlog-Kanal (leer = deaktiviert)
MODLOG_WEBHOOK_URL=
# Standard fuer Server ohne gespeicherte Sprache: de, en oder nl
BOT_DEFAULT_LANGUAGE=en

# Discord user ID allowed to use /restart and owner commands
BOT_OWNER_ID=

# Dedicated MongoDB container for Main Tori. Use a long alphanumeric password.
TORI_MONGO_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# YouTube Data API v3 key (Spotify-to-YouTube lookup)
YOUTUBE_API_KEY=
