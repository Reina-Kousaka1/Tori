DISCORD_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=
BOT_OWNER_ID=
BOT_DEFAULT_LANGUAGE=de

TORI_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
LAVALINK_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Generate a separate random value; share only with the Java bot and economy-api containers.
# Java also uses this private API credential for semantic Tori Presence context; provider failures fall back locally.
TORI_ECONOMY_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TORI_ECONOMY_ROUTING=balance=LEGACY,inventory=LEGACY,shop=LEGACY,leaderboard=LEGACY,daily=LEGACY,transfer=LEGACY
TORI_ECONOMY_WRITE_ENABLED=false
TORI_ECONOMY_WRITE_MODE=disabled
TORI_ECONOMY_PRODUCTION_DATABASE_NAME=
TORI_ECONOMY_PRODUCTION_CUTOVER_ACK=
TORI_ECONOMY_PRODUCTION_WRITE_OPERATIONS=
TORI_SHOP_ROTATION_HOURS=24
TORI_SHOP_ROTATION_SIZE=12

# Optional main-bot Elixir handlers for /career and /profile.
# When enabled, Economy API uses the DISCORD_TOKEN and DISCORD_GUILD_ID above.
TORI_NOSTRUM_ENABLED=false
